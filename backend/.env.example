# Copy to .env. Never commit .env; tokens are never logged.
PI_BROKER=fixture                 # fixture | kite_connect | kite_mcp
# PI_INSTANCE=main                # a second backend for a second Kite user: e.g. "second" (README)
# PI_DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio
# PI_KITE_MCP_URL=https://mcp.kite.trade/mcp
# PI_KITE_API_KEY=
# PI_KITE_ACCESS_TOKEN=           # expires daily
# PI_GEMINI_API_KEY=              # without it, explanations use the offline template
# PI_MAX_POSITION_WEIGHT=0.15
# PI_MAX_SECTOR_WEIGHT=0.35
# PI_AI_DAILY_CAP_PER_FEATURE=200 # per feature (explain, suggest, news, chat), resets at midnight IST

# Telegram alerts (a bot of your own, from @BotFather; then press "Link" on the Alerts page)
# PI_TELEGRAM_BOT_TOKEN=
# PI_NOTIFY_MIN_SEVERITY=medium   # high | medium
# PI_NOTIFY_QUIET_START=22:00     # IST
# PI_NOTIFY_QUIET_END=07:00
# PI_APP_URL=http://localhost:5173
